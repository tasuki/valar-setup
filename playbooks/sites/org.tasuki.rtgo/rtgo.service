[Unit]
Description=Real Time GO (Podman)

[Service]
Restart=always
RestartSec=10
ExecStart=/usr/bin/podman run --rm --replace --name rtgo --pull=never --publish 127.0.0.1:4760:8000 --env-file {{ chdir }}/.env --volume {{ chdir }}/data:/data {{ rtgo_image }}
ExecStop=/usr/bin/podman stop --ignore --time 30 rtgo
ExecStopPost=/usr/bin/podman rm --force --ignore rtgo
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
